{
    "name": "switchboard",
    "version": "0.0.0",
    "description": "Connects Microsoft Teams channels to Claude Managed Agents",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "start": "node dist/index.js",
        "dev": "node src/index.ts",
        "test": "node --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
        "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"test/integration/**/*.test.ts\"",
        "test:all": "pnpm test && pnpm test:integration",
        "teams-app": "node teams-app/build.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "1.3.0",
        "@azure/data-tables": "13.3.2",
        "@azure/identity": "4.14.1",
        "@microsoft/agents-activity": "1.9.1",
        "@microsoft/agents-hosting": "1.9.1",
        "croner": "11.0.0",
        "express": "5.3.0",
        "node-html-markdown": "2.0.0",
        "pino": "10.4.0",
        "sharp": "0.35.5",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/express": "5.0.6",
        "@types/node": "22.20.5",
        "testcontainers": "12.2.1",
        "typescript": "7.0.2"
    }
}
