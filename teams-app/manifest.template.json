{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
    "manifestVersion": "1.19",
    "version": "{{VERSION}}",
    "id": "{{APP_ID}}",
    "developer": {
        "name": "{{DEVELOPER_NAME}}",
        "websiteUrl": "{{WEBSITE_URL}}",
        "privacyUrl": "{{PRIVACY_URL}}",
        "termsOfUseUrl": "{{TERMS_URL}}"
    },
    "name": {
        "short": "{{NAME}}",
        "full": "{{NAME}}"
    },
    "description": {
        "short": "{{SHORT_DESCRIPTION}}",
        "full": "{{FULL_DESCRIPTION}}"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "accentColor": "#2563EB",
    "bots": [
        {
            "botId": "{{BOT_ID}}",
            "scopes": ["team"],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": ["team"],
                    "commands": [
                        {
                            "title": "settings",
                            "description": "Admins: connect this channel to a deployment and set up its job"
                        },
                        {
                            "title": "status",
                            "description": "Show the channel's deployments, job and active conversations"
                        },
                        { "title": "pause", "description": "Admins: turn the channel's job off" },
                        { "title": "resume", "description": "Admins: turn the channel's job on" },
                        { "title": "run", "description": "Admins: start a job run now" },
                        {
                            "title": "upgrade",
                            "description": "Admins: move this channel's deployments to the newest agent versions"
                        },
                        { "title": "disconnect", "description": "Admins: disconnect Switchboard from this channel" }
                    ]
                }
            ]
        }
    ],
    "validDomains": [],
    "webApplicationInfo": {
        "id": "{{BOT_ID}}",
        "resource": "https://RscBasedStoreApp"
    },
    "authorization": {
        "permissions": {
            "resourceSpecific": [
                {
                    "name": "ChannelMessage.Read.Group",
                    "type": "Application"
                }
            ]
        }
    }
}
