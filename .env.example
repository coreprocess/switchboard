# Local configuration for `node --env-file .env src/index.ts`. Copy to .env (gitignored) and adjust.
# Without the CONNECTIONS__… settings the bot accepts unauthenticated activities (local testing only).
ANTHROPIC_API_KEY=sk-ant-…
# or Workload Identity Federation instead of the key: ANTHROPIC_FEDERATION_RULE_ID, ANTHROPIC_ORGANIZATION_ID,
# ANTHROPIC_SERVICE_ACCOUNT_ID, ANTHROPIC_WORKSPACE_ID, ANTHROPIC_IDENTITY_TOKEN_FILE
CLAUDE_WEBHOOK_SECRET=whsec_…
SWITCHBOARD_MCP_TOKENS={"<random token, 32+ characters>": {"name": "local-agent", "channels": ["ops"]}}
SWITCHBOARD_CONFIG=./channels.local.yaml
SWITCHBOARD_PUBLIC_URL=https://switchboard.example.com
PORT=8080
LOG_LEVEL=debug

# Azurite (docker run -p 10002:10002 mcr.microsoft.com/azure-storage/azurite azurite-table --tableHost 0.0.0.0)
STORE_KIND=azure-tables
STORE_TABLES_CONNECTION_STRING=UseDevelopmentStorage=true
# or STORE_KIND=memory
