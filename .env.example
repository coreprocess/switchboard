# Local configuration for `node --env-file .env src/index.ts`. Copy to .env (gitignored) and adjust.
# Without the CONNECTIONS__… settings the bot accepts unauthenticated activities (local testing only).
SWITCHBOARD_TENANTS=["00000000-0000-0000-0000-000000000000"]
SWITCHBOARD_ADMINS=[{"tenant": "00000000-0000-0000-0000-000000000000", "object_id": "00000000-0000-0000-0000-000000000001"}]
# A workspace signed in with an API key (local development); production uses "federation" (see README)
SWITCHBOARD_WORKSPACES=[{"id": "wrkspc_xxx", "name": "Dev", "api_key_env": "ANTHROPIC_API_KEY"}]
ANTHROPIC_API_KEY=sk-ant-…
CLAUDE_WEBHOOK_SECRETS={"wrkspc_xxx": "whsec_…"}
SWITCHBOARD_PUBLIC_URL=https://switchboard.example.com
PORT=8080
LOG_LEVEL=debug

# Azurite (docker run -p 10002:10002 mcr.microsoft.com/azure-storage/azurite azurite-table --tableHost 0.0.0.0)
STORE_KIND=azure-tables
STORE_TABLES_CONNECTION_STRING=UseDevelopmentStorage=true
SWITCHBOARD_TABLE_PREFIX=dev
# or STORE_KIND=memory
